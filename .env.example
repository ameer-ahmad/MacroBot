VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup)
VITE_USDA_API_KEY=

# AI meal/label features (OpenAI) are powered by the `ai-meal` Supabase Edge
# Function. The OpenAI key lives server-side as a Supabase secret, NOT here:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase functions deploy ai-meal
